# Maison Hygia environment configuration.
# Copy this file to `.env` and fill in real values; safe defaults are used otherwise.

# Backend database URL (REQUIRED — PostgreSQL connection string).
# Supabase and AWS RDS both use PostgreSQL.
# Examples:
#   postgresql://postgres:password@localhost:5432/maison_hygia
#   postgresql://postgres:pw@db.supabase.co:5432/postgres
#   postgresql://user:pw@aws-rds-endpoint:5432/maison_hygia
DATABASE_URL=

# Stripe - set real test/live keys. Leave blank for local-only dev;
# checkout/webhook endpoints will return 503 until set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend base URL used by the backend for Stripe checkout redirects
FRONTEND_URL=http://localhost:8000

# Base URL that serve_frontend.py proxies /api, /cart, /payment to
BACKEND_URL=http://127.0.0.1:8000

# Comma-separated CORS origins for the backend API
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001