# Maison Hygia environment configuration.
# Copy this file to `.env` and fill in real values; safe defaults are used otherwise.

# Backend database URL (REQUIRED — PostgreSQL connection string).
# Examples:
#   postgresql://postgres:password@localhost:5432/maison_hygia
#   postgresql://user:pw@aws-rds-endpoint:5432/maison_hygia
DATABASE_URL=

# Stripe - set real test/live keys. Leave blank for local-only dev;
# checkout/webhook endpoints will return 503 until set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend base URL used by the backend for Stripe checkout redirects
FRONTEND_URL=http://localhost:8000

# Base URL that `python cli.py serve` proxies /api, /cart, /payment to
BACKEND_URL=http://127.0.0.1:8001

# Comma-separated CORS origins for the backend API
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001

# AWS Cognito (required for admin dashboard authentication)
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
AWS_REGION=us-east-1

# AWS S3 (used for admin product image uploads via presigned URLs)
S3_ASSETS_BUCKET=
# Public CDN domain that serves the bucket (must be in ALLOWED_ORIGINS-adjacent CORS config)
CF_ASSETS_DOMAIN=assets.maisonhygia.adityanair.tech

# Create tables on startup (dev convenience). Production uses Alembic migrations.
AUTO_CREATE_SCHEMA=true

# Log level for the JSON-structured backend logs
LOG_LEVEL=INFO